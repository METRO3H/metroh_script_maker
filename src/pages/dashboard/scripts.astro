---
// dashboard/scripts.astro
import Layout from "@layouts/MainLayout.astro";
import ScriptList from "@components/ScriptList/ScriptList.svelte";
import { supabase } from "@supabase/supabase";
import { require_auth, clear_auth } from "@utils/auth";

const auth = await require_auth(Astro.cookies).catch(() => null);
if (!auth) {
  clear_auth(Astro.cookies);
  return Astro.redirect("/auth/sign");
}

const { user } = auth;
const { data: scripts } = await supabase.rpc("get_user_scripts");
const script_list = scripts ?? [];
---

<Layout title="Mis scripts">
  <div class="scripts-page">

    <header class="app-header">
      <a href="/dashboard/scripts" class="app-wordmark">Metroh</a>

      <div class="app-header-right">
        <span class="app-user-email">{user.email}</span>

        <button class="theme-toggle" aria-label="Cambiar tema">
          <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="15" height="15"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" style="display:none">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
          <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="15" height="15"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>

        <a href="/api/auth/signout" class="btn btn-danger-ghost btn-sm">
          Cerrar sesión
        </a>
      </div>
    </header>

    <main class="scripts-main">
      <div class="section-header">
        <div>
          <h1 class="section-title">Mis scripts</h1>
          <p class="section-sub">
            {script_list.length === 0
              ? "Todavía no has guardado ninguno"
              : `${script_list.length} script${script_list.length !== 1 ? "s" : ""} guardado${script_list.length !== 1 ? "s" : ""}`
            }
          </p>
        </div>
        <a href="/dashboard" class="btn btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24"
            fill="none" stroke="currentColor" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="M12 5v14"/>
          </svg>
          Nuevo script
        </a>
      </div>

      <ScriptList client:load scripts={script_list} />
    </main>
  </div>
</Layout>

<style>
  .scripts-page {
    min-height: 100vh;
    background: var(--bg-subtle);
    display: flex;
    flex-direction: column;
  }
  .scripts-main {
    flex: 1;
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
    padding: 36px 24px 80px;
  }
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 28px;
    gap: 16px;
  }
  .section-title {
    font-size: 22px;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 4px;
  }
  .section-sub {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
  }
  .btn-sm { font-size: 10px; padding: 5px 12px; }
</style>