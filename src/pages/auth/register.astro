---
import Layout from "@layouts/MainLayout.astro";
---

<Layout title="Crear cuenta">
  <div class="auth-page">

    <button class="theme-toggle auth-theme-toggle" aria-label="Cambiar tema">
      <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round" style="display:none">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
      </svg>
      <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
        viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
      </svg>
    </button>

    <div class="auth-card">
      <p class="auth-wordmark">Metroh</p>

      <h1 class="auth-title">Crear cuenta</h1>
      <p class="auth-subtitle">
        ¿Ya tienes cuenta?
        <a href="/auth/login" class="auth-link">Inicia sesión</a>
      </p>

      <form action="/api/auth/register" method="post" class="auth-form">
        <div class="auth-field">
          <label for="email" class="auth-label">Email</label>
          <input type="email" name="email" id="email" placeholder="tu@email.com"
            class="auth-input" autocomplete="email" required />
        </div>
        <div class="auth-field">
          <label for="password" class="auth-label">Contraseña</label>
          <input type="password" name="password" id="password" placeholder="••••••••"
            class="auth-input" autocomplete="new-password" required />
        </div>
        <button type="submit" class="btn btn-primary auth-submit">Crear cuenta</button>
      </form>
    </div>
  </div>
</Layout>

<style>
  .auth-page {
    min-height: 100vh; background: var(--bg);
    display: flex; align-items: center; justify-content: center;
    padding: 24px; position: relative;
  }
  .auth-theme-toggle { position: absolute; top: 20px; right: 20px; }
  .auth-card { width: 100%; max-width: 360px; }
  .auth-wordmark {
    font-family: var(--font-mono); font-size: 11px; font-weight: 700;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--text-muted); margin-bottom: 40px;
  }
  .auth-title { font-size: 26px; font-weight: 300; color: var(--text-primary); margin-bottom: 6px; letter-spacing: -0.02em; }
  .auth-subtitle { font-size: 13px; color: var(--text-muted); margin-bottom: 32px; }
  .auth-link { color: var(--text-secondary); text-decoration: underline; text-underline-offset: 3px; transition: color var(--transition); }
  .auth-link:hover { color: var(--accent-text); }
  .auth-form { display: flex; flex-direction: column; gap: 16px; }
  .auth-field { display: flex; flex-direction: column; gap: 6px; }
  .auth-label { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); }
  .auth-submit { width: 100%; padding: 11px; margin-top: 4px; font-size: 12px; }
</style>
