---
import ScriptEditor from "@components/ScriptEditor/ScriptEditor.svelte";
import Layout from "@layouts/MainLayout.astro";
import { supabase } from "@supabase/supabase";
import { require_auth, clear_auth } from "@utils/auth";

const auth = await require_auth(Astro.cookies).catch(() => null);
if (!auth) {
  clear_auth(Astro.cookies);
  return Astro.redirect("/auth/login");
}

const { user } = auth;
let initialScript = null;

const script_id = Astro.url.searchParams.get("id");
if (script_id) {
  const { data, error } = await supabase.rpc("get_script_detail", { p_script_id: script_id });
  if (!error && data) initialScript = data;
}
---

<Layout title={initialScript ? `Editando: ${initialScript.name}` : "Nuevo script"}>
  <div class="dashboard">
    <header class="app-header">
      <a href="/scripts" class="app-wordmark">Metroh</a>

      <div class="app-header-right">
        <a href="/scripts" class="btn btn-ghost btn-sm">
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
          </svg>
          Mis scripts
        </a>

        <span class="app-user-email">{user.email}</span>

        <button class="theme-toggle" aria-label="Cambiar tema">
          <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="15" height="15"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" style="display:none">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
          </svg>
          <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="15" height="15"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
          </svg>
        </button>

        <a href="/api/auth/logout" class="btn btn-danger-ghost btn-sm">Cerrar sesión</a>
      </div>
    </header>

    <main class="dashboard-main">
      <div class="editor-card card">
        <ScriptEditor client:load initialScript={initialScript} />
      </div>
    </main>
  </div>
</Layout>

<style>
  .dashboard { height: 100vh; background: var(--bg-subtle); display: flex; flex-direction: column; overflow: hidden; }
  .dashboard-main { flex: 1; min-height: 0; display: flex; justify-content: center; padding: 24px 16px; }
  .editor-card { width: 100%; max-width: 820px; height: calc(100vh - 96px); display: flex; flex-direction: column; overflow: hidden; }
  .btn-sm { font-size: 10px; padding: 5px 12px; }
</style>
