{
   "extends": "astro/tsconfigs/strict",
   "include": [".astro/types.d.ts", "**/*"],
   "exclude": ["dist"],
   "compilerOptions": {
      "paths": {
         "@components/*": ["./src/components/*"],
         "@assets/*": ["./src/assets/*"],
         "@lib/*": ["./src/lib/*"],
         "@pages/*": ["./src/pages/*"],
         "@layouts/*": ["./src/layouts/*"],
         "@styles/*": ["./src/styles/*"],
         "@utils/*": ["./src/utils/*"]
      }
   }
}
